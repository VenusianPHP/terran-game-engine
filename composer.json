{
    "name": "venusian/terran",
    "description": "A Godot-shaped game engine for Venusian Framework applications: Scenes, a World, Viewports over any Surface output target, physics on the loop and rendering on the sketch.",
    "type": "library",
    "version": "0.10.0",
    "license": "MIT",
    "authors": [
        { "name": "Project Saturn Studios, LLC", "email": "info@projectsaturnstudios.com" }
    ],
    "require": {
        "php": "^8.4|^8.5",
        "venusian-surface/bridge": "^0.10.0",
        "venusian-surface/contracts": "^0.10.0",
        "venusian-surface/drawing": "^0.10.0",
        "venusian-surface/fonts": "^0.10.0",
        "venusian-surface/framebuffers": "^0.10.0",
        "venusian-surface/human-input": "^0.10.0",
        "venusian-surface/images": "^0.10.0",
        "venusian-surface/nuts-and-bolts": "^0.10.0",
        "venusian-surface/windows": "^0.10.0",
        "venusian-voyager/console": "^0.10.0",
        "venusian-voyager/contracts": "^0.10.0",
        "venusian-voyager/io-pools": "^0.10.0",
        "venusian-voyager/nuts-and-bolts": "^0.10.0",
        "venusian-voyager/signals": "^0.10.0",
        "venusian-voyager/sketches": "^0.10.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^4",
        "venusian-voyager/config": "^0.10.0",
        "venusian-voyager/vessel": "^0.10.0"
    },
    "repositories": [
        { "type": "path", "url": "../framework/src/Voyager/*", "options": { "symlink": true } },
        { "type": "path", "url": "../surface/src/Surface/*", "options": { "symlink": true } }
    ],
    "autoload": {
        "psr-4": { "Terran\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "extra": {
        "branch-alias": { "dev-main": "0.10.x-dev" },
        "venusian": {
            "providers": [ "Terran\\TerranServiceProvider" ]
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": { "pestphp/pest-plugin": true }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
